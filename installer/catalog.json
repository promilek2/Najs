{
  "version": 1,
  "base_packages": [
    "7zip",
    "alsa-firmware",
    "ark",
    "avahi",
    "bash-completion",
    "bluez-obex",
    "bluez-utils",
    "btop",
    "btrfs-progs",
    "cups",
    "cups-pdf",
    "cups-pk-helper",
    "fastfetch",
    "fd",
    "firewalld",
    "firefox",
    "flatpak",
    "fwupd",
    "git",
    "gnome-software",
    "gst-plugin-pipewire",
    "gst-plugins-bad",
    "gst-plugins-good",
    "gst-plugins-ugly",
    "jq",
    "keepassxc",
    "man-pages",
    "networkmanager",
    "networkmanager-openvpn",
    "noto-fonts",
    "noto-fonts-cjk",
    "noto-fonts-emoji",
    "pipewire",
    "pipewire-alsa",
    "pipewire-pulse",
    "power-profiles-daemon",
    "qemu-guest-agent",
    "ripgrep",
    "sof-firmware",
    "spice-vdagent",
    "sudo",
    "system-config-printer",
    "ttf-liberation",
    "unrar",
    "unzip",
    "virtualbox-guest-utils",
    "wget",
    "wireplumber",
    "zenity",
    "zip"
  ],
  "base_services": [
    "NetworkManager",
    "avahi-daemon",
    "bluetooth",
    "cups",
    "firewalld",
    "fstrim.timer",
    "power-profiles-daemon",
    "vboxservice"
  ],
  "desktops": {
    "kde": {
      "label": "KDE Plasma",
      "description": "A complete and flexible desktop. Recommended for most users.",
      "profile": "KDE Plasma",
      "greeter": "sddm",
      "service": "sddm",
      "environment": "plasma",
      "session": "wayland",
      "packages": [
        "dolphin",
        "kate",
        "kcalc",
        "konsole",
        "partitionmanager",
        "plasma-meta",
        "sddm",
        "xdg-desktop-portal-kde"
      ]
    },
    "gnome": {
      "label": "GNOME",
      "description": "A focused desktop with large, accessible controls.",
      "profile": "GNOME",
      "greeter": "gdm",
      "service": "gdm",
      "environment": "gnome",
      "session": "wayland",
      "packages": [
        "gdm",
        "gnome",
        "gnome-disk-utility",
        "xdg-desktop-portal-gnome"
      ]
    },
    "hyprland": {
      "label": "Hyprland",
      "description": "A lightweight tiling Wayland desktop for keyboard-driven workflows.",
      "profile": "Hyprland",
      "greeter": "sddm",
      "service": "sddm",
      "environment": "hyprland",
      "session": "wayland",
      "packages": [
        "brightnessctl",
        "grim",
        "hyprland",
        "kitty",
        "mako",
        "network-manager-applet",
        "nwg-look",
        "nwg-displays",
        "polkit-gnome",
        "pavucontrol",
        "sddm",
        "slurp",
        "swaybg",
        "swaylock",
        "thunar",
        "waybar",
        "wl-clipboard",
        "xdg-desktop-portal-gtk",
        "xdg-desktop-portal-hyprland",
        "xdg-user-dirs",
        "wofi"
      ]
    },
    "xfce": {
      "label": "Xfce",
      "description": "A lightweight classic desktop for older computers.",
      "profile": "Xfce4",
      "greeter": "lightdm-gtk-greeter",
      "service": "lightdm",
      "environment": "xfce",
      "session": "xorg",
      "packages": [
        "gvfs",
        "lightdm",
        "lightdm-gtk-greeter",
        "network-manager-applet",
        "pavucontrol",
        "xdg-desktop-portal-gtk",
        "xdg-desktop-portal-xapp",
        "xfce4",
        "xfce4-goodies",
        "xorg-server"
      ]
    },
    "cinnamon": {
      "label": "Cinnamon",
      "description": "A familiar traditional desktop layout.",
      "profile": "Cinnamon",
      "greeter": "lightdm-gtk-greeter",
      "service": "lightdm",
      "environment": "cinnamon",
      "session": "xorg",
      "packages": [
        "cinnamon",
        "gnome-terminal",
        "lightdm",
        "lightdm-gtk-greeter",
        "network-manager-applet",
        "xdg-desktop-portal-gtk",
        "xdg-desktop-portal-xapp",
        "xorg-server"
      ]
    }
  },
  "gpus": {
    "auto": {
      "label": "Automatic / open-source drivers",
      "description": "The safest option when the graphics hardware is unknown.",
      "driver": "All open-source",
      "gaming_packages": [
        "lib32-mesa",
        "lib32-vulkan-intel",
        "lib32-vulkan-nouveau",
        "lib32-vulkan-radeon"
      ]
    },
    "amd": {
      "label": "AMD / ATI",
      "description": "Open-source Mesa and RADV drivers.",
      "driver": "AMD / ATI (open-source)",
      "gaming_packages": [
        "lib32-mesa",
        "lib32-vulkan-radeon"
      ]
    },
    "intel": {
      "label": "Intel",
      "description": "Open-source Intel Mesa drivers.",
      "driver": "Intel (open-source)",
      "gaming_packages": [
        "lib32-mesa",
        "lib32-vulkan-intel"
      ]
    },
    "nvidia": {
      "label": "NVIDIA Turing or newer",
      "description": "NVIDIA open kernel module with official user-space libraries.",
      "driver": "Nvidia (open kernel module for newer GPUs, Turing+)",
      "gaming_packages": [
        "lib32-nvidia-utils"
      ]
    },
    "vm": {
      "label": "Virtual machine",
      "description": "Guest drivers for VirtualBox and QEMU test systems.",
      "driver": "VirtualBox (open-source)",
      "gaming_packages": [
        "lib32-mesa"
      ]
    }
  },
  "bundles": {
    "office": {
      "label": "Office and documents",
      "description": "LibreOffice, PDF tools, and English and Polish dictionaries.",
      "packages": [
        "hunspell-en_us",
        "hunspell-pl",
        "libreoffice-fresh",
        "okular"
      ],
      "services": []
    },
    "media": {
      "label": "Multimedia",
      "description": "Music, video, and image playback.",
      "packages": [
        "gwenview",
        "vlc"
      ],
      "services": []
    },
    "gaming": {
      "label": "Gaming",
      "description": "Steam, Lutris, Wine, GameMode, Gamescope, MangoHud, Discord, and OBS.",
      "packages": [
        "discord",
        "gamemode",
        "gamescope",
        "lib32-vulkan-icd-loader",
        "lutris",
        "mangohud",
        "obs-studio",
        "protontricks",
        "steam",
        "vulkan-icd-loader",
        "vulkan-tools",
        "wine",
        "wine-gecko",
        "wine-mono",
        "winetricks",
        "yad"
      ],
      "services": [],
      "repositories": [
        "multilib"
      ]
    },
    "creator": {
      "label": "Creative studio",
      "description": "Blender, Krita, GIMP, Inkscape, Kdenlive, Audacity, and OBS.",
      "packages": [
        "audacity",
        "blender",
        "gimp",
        "inkscape",
        "kdenlive",
        "krita",
        "obs-studio"
      ],
      "services": []
    },
    "development": {
      "label": "Development",
      "description": "Code, GitHub CLI, Rust, Python, Node.js, Podman, and Distrobox.",
      "packages": [
        "base-devel",
        "code",
        "distrobox",
        "github-cli",
        "nodejs",
        "npm",
        "podman",
        "python-pip",
        "rustup"
      ],
      "services": []
    },
    "communication": {
      "label": "Communication",
      "description": "Discord, Signal, Telegram, and Thunderbird.",
      "packages": [
        "discord",
        "signal-desktop",
        "telegram-desktop",
        "thunderbird"
      ],
      "services": []
    },
    "virtualization": {
      "label": "Virtualization",
      "description": "QEMU/KVM, libvirt, and Virtual Machine Manager.",
      "packages": [
        "dnsmasq",
        "edk2-ovmf",
        "libvirt",
        "qemu-full",
        "virt-manager"
      ],
      "services": [
        "libvirtd"
      ]
    }
  },
  "use_cases": {
    "minimal": {
      "label": "Minimal",
      "description": "Desktop, browser, and essential system tools only.",
      "bundles": []
    },
    "standard": {
      "label": "Everyday",
      "description": "Office, documents, and multimedia.",
      "bundles": [
        "office",
        "media"
      ]
    },
    "gaming": {
      "label": "Gamer",
      "description": "A complete gaming and communication setup.",
      "bundles": [
        "office",
        "media",
        "gaming",
        "communication"
      ]
    },
    "creator": {
      "label": "Creator",
      "description": "Office, multimedia, and creative applications.",
      "bundles": [
        "office",
        "media",
        "creator"
      ]
    },
    "development": {
      "label": "Developer",
      "description": "Development tools and local virtual machines.",
      "bundles": [
        "office",
        "media",
        "development",
        "virtualization"
      ]
    },
    "everything": {
      "label": "Everything",
      "description": "Every available software collection.",
      "bundles": [
        "office",
        "media",
        "gaming",
        "creator",
        "development",
        "communication",
        "virtualization"
      ]
    }
  }
}
